# Local Ollama generation (optional).
PAPERTRAIL_LLM_PROVIDER=ollama
PAPERTRAIL_LLM_MODEL=
PAPERTRAIL_OLLAMA_URL=http://127.0.0.1:11434
PAPERTRAIL_LLM_TIMEOUT=60
PAPERTRAIL_LLM_BUDGET_USD=0.50

# Optional OpenAI-compatible provider. Keep API keys in environment variables.
PAPERTRAIL_OPENAI_API_KEY_ENV=
PAPERTRAIL_OPENAI_BASE_URL=
